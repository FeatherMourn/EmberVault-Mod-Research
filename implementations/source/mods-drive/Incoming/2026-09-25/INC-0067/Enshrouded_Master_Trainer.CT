  jne short @f
   lea rax,[rcx+r14*4]
   mov [pIntStats+98],rax // Crit Chance
  @@:
  mov rax,000000004E7A23BB
  cmp rax,rdi
  jne short @f
   lea rax,[rcx+r14*4]
   mov [pIntStats+A0],rax // Crit Damage
  @@:
  mov rax,000000008D974C88
  cmp rax,rdi
  jne short @f
   lea rax,[rcx+r14*4]
   mov [pIntStats+A8],rax // Mining Damage
  @@:
  mov rax,00000000A1188D33
