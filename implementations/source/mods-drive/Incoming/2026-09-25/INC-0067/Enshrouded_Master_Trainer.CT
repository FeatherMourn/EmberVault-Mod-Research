return_int:

[DISABLE]
aobFloatAnchor:
  db F3 0F 11 34 91
unregistersymbol(pFloatStats)
unregistersymbol(aobFloatAnchor)
dealloc(memFloatHook)

aobIntAnchor:
  db F3 42 0F 11 04 B1
unregistersymbol(pIntStats)
unregistersymbol(aobIntAnchor)
