aobscanmodule(aobWndProc,enshrouded.exe,48 89 4C 24 08 55 53 56 57 41 55 41 56 41 57 48 8D AC 24 10 FA FF FF)
alloc(newmem_wnd,$1000,aobWndProc)
label(code_wnd)
label(return_wnd)

newmem_wnd:
  cmp edx,100 // WM_KEYDOWN
  jne code_wnd
  cmp r8,52 // R key
  jne @f
  xor byte ptr [bRun],1
@@:
  mov [iKey],r8d
code_wnd:
  mov [rsp+08],rcx
  push rbp
  jmp return_wnd

