aobscanmodule(speed_a,enshrouded.exe,F2 0F 10 08 F2 41 0F 59 C2) // should be unique
aobscanmodule(speed_b,enshrouded.exe,F3 0F 59 58 08 F3 0F 59) // should be unique
alloc(newmem_a,$1000,speed_a)
alloc(newmem_b,$1000,speed_b)

label(hero_code_a)
label(hero_code_b)

newmem_a:
  cmp [rax+00000208],3f666666
  je hero_code_a
  movsd xmm1,[rax]
  mulsd xmm0,xmm10
  jmp speed_a+09

hero_code_a:
  movsd xmm1,[rax]
  mov [rax+20],(float)2.5
  mulss xmm1,[rax+20]
  mulsd xmm0,xmm10
  jmp speed_a+09

newmem_b:
  cmp [rax+00000208],3f666666
  je hero_code_b
  mulss xmm3,[rax+08]
  jmp speed_b+05

hero_code_b:
  mulss xmm3,[rax+08]
  mov [rax+20],(float)2.5
  mulss xmm3,[rax+20]
  jmp speed_b+05

speed_a:
  jmp newmem_a
  nop 4

speed_b:
  jmp newmem_b

registersymbol(speed_a)
registersymbol(speed_b)

[DISABLE]

speed_a:
  db F2 0F 10 08 F2 41 0F 59 C2

speed_b:
  db F3 0F 59 58 08

unregistersymbol(speed_a)
unregistersymbol(speed_b)
dealloc(newmem_a)
dealloc(newmem_b)

