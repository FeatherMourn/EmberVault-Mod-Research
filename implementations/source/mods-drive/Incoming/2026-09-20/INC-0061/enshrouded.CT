aobscanmodule(day_time,enshrouded.exe,48 89 47 48 49 3B 07) // should be unique
alloc(newmem,$1000,day_time)
alloc(_day_time,4)
label(return)

newmem:
  mov [_day_time],rdi
  mov [rdi+48],rax
  mov [rdi+4c],(int)12000 // 12000 = 12 hours or midday, 24000 = 24 hours or midnight
  cmp rax,[r15]
  jmp return

day_time:
  jmp newmem
  nop 2
return:
registersymbol(day_time)
