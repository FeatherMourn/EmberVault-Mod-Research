[ENABLE]

aobscanmodule(health,enshrouded_server.exe,4C 8D 5C 24 70 48 8B C3 49 8B 5B 10 49 8B 6B 18 49 8B 73 20 49 8B 7B 28) // should be unique
alloc(newmem,$1000,health)

label(code)
label(hero_code)
label(return)

newmem:
  cmp [rcx+rdx*4+00000014],00000320
  je hero_code

code:
  add [rcx+rdx*4],edi
  lea rcx,[rsp+30]
  jmp return

hero_code:
  sub [rcx+rdx*4],edi
  lea rcx,[rsp+30]
  jmp return

health+86:
  jmp newmem
  nop 3
return:
registersymbol(health)

[DISABLE]

health+86:
  db 01 3C 91 48 8D 4C 24 30

unregistersymbol(health)
dealloc(newmem)

