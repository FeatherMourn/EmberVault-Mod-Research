[ENABLE]

aobscanmodule(PropPreviewScaleAOB,enshrouded.exe,F3 45 0F 11 46 28) // should be unique
aobscanmodule(PropPlacementScaleAOB,enshrouded.exe,0F 29 45 C0 66 0F 7F 8D 30 01 00 00) // should be unique
alloc(newmem,$1000,PropPreviewScaleAOB)

label(placementCode)
label(placementReturn)
label(previewCode)
label(previewReturn)
label(propScaleData)

newmem:
previewCode:
  movss xmm8,[propScaleData]
  movss [r14+28],xmm8
  jmp previewReturn

placementCode:
  cmp rdi,18
  jne _placeFailCode
  cmp rcx,0
  je _placeFailCode
  cmp [rcx+8],38
  jne _placeFailCode

  push rax
  push rdi

  mov rax,[rcx]
  mov edi,[propScaleData]
  mov [rax+28],edi
  mov [rax+2C],edi
  mov [rax+30],edi

  pop rdi
  pop rax

  _placeFailCode:
  movaps [rbp-40],xmm0
  movdqa [rbp+00000130],xmm1
  jmp placementReturn

  propScaleData:
  dd (float)1

PropPreviewScaleAOB:
  jmp previewCode
  nop
  previewReturn:

PropPlacementScaleAOB:
  jmp placementCode
  nop 7
  placementReturn:

registersymbol(PropPreviewScaleAOB)
registersymbol(PropPlacementScaleAOB)
registersymbol(propScaleData)

[DISABLE]

PropPreviewScaleAOB:
  db F3 45 0F 11 46 28

PropPlacementScaleAOB:
  db 0F 29 45 C0 66 0F 7F 8D 30 01 00 00

unregistersymbol(PropPreviewScaleAOB)
unregistersymbol(PropPlacementScaleAOB)
unregistersymbol(propScaleData)
dealloc(newmem)



</AssemblerScript>
