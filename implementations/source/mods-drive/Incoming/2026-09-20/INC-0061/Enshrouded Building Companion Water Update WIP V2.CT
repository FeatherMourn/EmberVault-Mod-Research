          <Description>"Override Placed Terrain/Block"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : enshrouded.exe
  Version:
  Date   : 2024-03-29
  Author : Turk

  This script does blah blah blah
}

[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat



aobscanmodule(BlockPlaceOverrideAOB,enshrouded.exe,41 0F B6 86 48 04 00 00 33) // should be unique
aobscanmodule(BlockPreviewAOB,enshrouded.exe,44 0F B6 A0 48 04 00 00)
alloc(newmem,$1000,BlockPlaceOverrideAOB)

label(code)
label(return)
label(code2)
label(return2)
label(BlockOverrideData)

label(BlockJump)
registersymbol(BlockOverrideData)

newmem:
  movzx eax,byte ptr [r14+00000448]
  cmp al,7f
  //db 77 19 8b 05 51 00 00 00
  ja BlockJump
  mov eax,[BlockOverrideData]
  cmp eax,0
  jne code
  mov eax,1
  jmp code
  BlockJump:
  mov eax,[BlockOverrideData+4]
  add eax,80

code:
  //movzx eax,byte ptr [rdi+000003F8]
  jmp return
db 90 90 90

code2:
  movzx r12d,byte ptr [rax+00000448]
  cmp r12d,7f
  ja _PBlock
  mov r12,[BlockOverrideData]
  cmp r12,80
  jb _validTerraID
  mov r12,1
  _validTerraID:
  jmp return2
  _PBlock:
  mov r12,[BlockOverrideData+4]
  add r12,80
  cmp r12,7f
  ja _validBlockID
  mov r12,80
  _validBlockID:
  jmp return2



  BlockOverrideData:
  dd 1

BlockPlaceOverrideAOB:
  jmp newmem
  nop 3
return:

BlockPreviewAOB:
  jmp code2
  nop 3
return2:




registersymbol(BlockPlaceOverrideAOB)
registersymbol(BlockPreviewAOB)

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
BlockPlaceOverrideAOB:
  db 41 0F B6 86 48 04 00 00

BlockPreviewAOB:
  db 44 0F B6 A0 48 04 00 00

unregistersymbol(BlockPlaceOverrideAOB)
unregistersymbol(BlockOverrideData)
unregistersymbol(BlockPreviewAOB)
dealloc(newmem)

{
