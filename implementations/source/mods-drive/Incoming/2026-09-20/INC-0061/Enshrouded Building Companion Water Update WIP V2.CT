[ENABLE]
//code from here to '[DISABLE]' will be used to enable the cheat

 
 
aobscanmodule(BlockSwapAOB,enshrouded.exe,41 0F B7 0C 43) // should be unique
alloc(newmem,$1000,BlockSwapAOB)

label(code)
label(return)
label(BlockSwapData)

newmem:
mov ecx,[BlockSwapData]
cmp ecx,0
jne _BCheck

movzx ecx,word ptr [r11+rax*2]
cmp cl,[BlockSwapData+4]
jne code
mov cl,[BlockSwapData+8]
cmp cl,0
jne _nullPass
and ecx,ff
_nullPass:
jmp return

_BCheck:
cmp ecx,1
jne _TBCheck
movzx ecx,word ptr [r11+rax*2]
push rax
mov eax,[BlockSwapData+4]
add eax,80
cmp cl,al
pop rax
jne code
mov cl,[BlockSwapData+8]
add cl,80
jmp return


_TBCheck:
cmp ecx,2
jne _BTCheck
movzx ecx,word ptr [r11+rax*2]
cmp cl,[BlockSwapData+4]
jne code
mov ecx,[BlockSwapData+8]
add ecx,80
jmp return



_BTCheck:
movzx ecx,word ptr [r11+rax*2]
sub ecx,80
cmp cl,[BlockSwapData+4]
jne code
mov cl,[BlockSwapData+8]
or ecx,ff00
cmp cl,0
jne _BTNullCheck
xor ecx,ecx

_BTNullCheck:
jmp return

code:
  movzx ecx,word ptr [r11+rax*2]
  jmp return
  BlockSwapData:

BlockSwapAOB:
  jmp newmem
return:
registersymbol(BlockSwapAOB)
registersymbol(BlockSwapData)

[DISABLE]
//code from here till the end of the code will be used to disable the cheat
