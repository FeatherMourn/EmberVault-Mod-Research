  je code
  cmp rax,[SaveSwapData]
  jne code
  mov rax,[rsi+8]
  cmp rax,[SaveSwapData+8]
  jne code

  mov rax,[SaveSwapData+10]
  mov [rsi],rax

  mov rax,[SaveSwapData+18]
  mov [rsi+8],rax


code:
  pop rax
  movups xmm0,[rsi]
  movups [rax+rdx*8],xmm0
  jmp return

  SaveSwapData:

SaveSwapTest:
  jmp newmem
  nop 2
return:
