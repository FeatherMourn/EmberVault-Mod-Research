              <AssemblerScript>[ENABLE]

aobscanmodule(aobWndProc,enshrouded.exe,48 89 4C 24 08 55 53 56 57 41 55 41 56 41 57 48 8D AC 24 10 FA FF FF) // should be unique
alloc(newmem,$1000,aobWndProc)

label(code)
label(return)
label(bActive)
registersymbol(bActive)
newmem:
 cmp edx,100 // msg
 jne code
 cmp r8d,52 // wparam "R"
 jne short @f
  xor byte ptr[bActive],1
 @@:
 cmp byte ptr[bActive],0
 je code
 mov rax,pPos
 mov rax,[rax]
 test rax,rax
 je code
 cmp r8d,10 // wparam "Shift"
 jne short @f
  movups xmm0,[rax+C]
  movsd xmm1,[iSpeed]
  paddq xmm0,xmm1
  movups [rax+C],xmm0
 @@:
 cmp r8d,11 // wparam "Control"
 jne short code
  movups xmm0,[rax+C]
  movsd xmm1,[iSpeed]
  psubq xmm0,xmm1
  movups [rax+C],xmm0
code:
  mov [rsp+08],rcx
  jmp return
iSpeed:
dq 1
bActive:
db 0

aobWndProc:
  jmp newmem
return:
registersymbol(aobWndProc)

