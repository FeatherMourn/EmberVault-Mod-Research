          <CheatEntries>
            <CheatEntry>
              <ID>1337321332</ID>
              <Description>"Auto Assemble script"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local Funcs = getAddress("pFuncs")

for i = 0, 999 do
 local Func = readPointer(Funcs+i*8)
 if Func == 0 then error("OK") end
 local pName = readPointer(Func+0x10)
 local Name = readString(pName,128,false)
 local pFunc = readPointer(Func+0x28)
 local Mod = getAddress("Enshrouded.exe")
 local Offset = pFunc - Mod
 printf("Enshrouded.exe+%x %s",Offset,Name)
end

function Enshrouded_TagID2Name(TagID)
    local BASE_PTR = getAddress "[enshrouded.exe+1A99E00]"
    local List = readPointer(BASE_PTR + 0x120)
	local List2 = readPointer(BASE_PTR + 0x80)
	local Fuckme = {List, List2}
	for Index, List in ipairs(Fuckme) do
		local RDX = readInteger(List + 4)
        local R9 = List + 8
        local CurrentTagIDAddress
        local RCX
	    local RAX
        local CurrentTagID
        repeat
            RCX = RDX
            RCX = RCX &gt;&gt; 1
            RAX = RCX + (RCX * 2)
		    CurrentTagIDAddress = R9 + (RAX * 8)
            CurrentTagID = readInteger(CurrentTagIDAddress)
            --printf("%X: %X | %X | RDX = %s", CurrentTagIDAddress, CurrentTagID, TagID, RDX)
            if CurrentTagID &lt;= TagID then
                R9 = CurrentTagIDAddress + 0x18
            end
			RDX = RCX
		    if CurrentTagID == TagID then
		        local Size = readInteger(CurrentTagIDAddress + 8)
                local StringAddress = CurrentTagIDAddress + readInteger(CurrentTagIDAddress + 4) + 4
                return readString(StringAddress, Size)
		    end
        until RDX == 0
	end
end

function Enshrounded_ConvertItemGUID2TagID(ItemGUID)
    local Key = 0x811C9DC5
    for Index, Byte in ipairs(ItemGUID) do
        local XoredByte = (Byte ~ Key) &amp; 0xFFFFFFFF
        Key = (XoredByte * 0x01000193) &amp; 0xFFFFFFFF
    end
    return Key
end

function File_Write_Desktop ( FilePath, Content )
    local Path = string.format( "%s\\%s",os.getenv "USERPROFILE" .. [[\Desktop]] ,FilePath )
	local File_Handle = io.open( Path ,  "wb" )
	File_Handle:write( Content )
	File_Handle:close()
	return Path
end


local Tableee = {}
function AddLine(format, ...)
	Tableee[#Tableee+1] = string.format(format,...)
end

function Enshoruded_Dump()
    local Base = getAddress "[[enshrouded.exe+1A9A280]+4A9060]"
    local Offset2ItemDataStructList = 0xA8

    local Count = 0

    local FirstItemAddress = readPointer( Base + Offset2ItemDataStructList + 0x8) + 0x20
    local SizeInBytes = ( ( readInteger(Base + Offset2ItemDataStructList + 0x10 ) - 0x28))
    for Current = FirstItemAddress, FirstItemAddress + SizeInBytes, 0x8 do
        local PossibleItemData = readPointer(Current)
        if readPointer(PossibleItemData) then
           local Hash_ButItsNotAHash = readInteger(PossibleItemData)
           --printf("Hash: %X", )
           local GUID = readBytes( PossibleItemData + 0x48, 0x10, true )
           if GUID then
               local TagID = Enshrounded_ConvertItemGUID2TagID( GUID )
               local Name = Enshrouded_TagID2Name( TagID )
               if Name then
               -- Hash_ButItsNotAHash
               -- Name
               AddLine('AddItem("%s",0x%08X)',Name,Hash_ButItsNotAHash)
                  Count = Count + 1
               else
                  --AddLine("Address: %016X, Hash: %08X, Name: FAILED TO GET NAME", Current, Hash_ButItsNotAHash)
               end
           else
               AddLine("What the fuck")
           end
        end
    end
    AddLine("Total items found: %d", Count)

	return File_Write_Desktop("Enshrouded Dump.txt",table.concat(Tableee,'\n'))
end

Enshoruded_Dump()


 
 
[DISABLE]

