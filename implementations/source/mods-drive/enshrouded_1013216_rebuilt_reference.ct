if syntaxcheck then return end
[ENABLE]

file = io.open("Enshrouded_Teleports.json", "r")
local content = "Null"
if file == nil then
 showMessage("Error: No Saved Positions") error("no saved pos")
else
 io.input(file)
 content = io.read()
 io.close(file)
end

List = json.decode(content)

TPNames = createStringList()

for i,v in pairs(List) do
 TPNames.add(v.Name)
end

local index,name = showSelectionList("Select A Location Name To Delete", "Select:", TPNames, false)
if index == -1 then error("no selection") return end

for i = #List, 1, -1 do
    if List[i].Name == name then
        table.remove(List, i)
        break
    end
end

local val = json.encode(List)
file = io.open("Enshrouded_Teleports.json", "w")
file:write(val)
file:close()
