// Query Only The Player Local/Host Vel Components:
aobscanmodule(aobPlayer_Focus,enshrouded.exe,0F 10 00 F2 0F 10 48 10 48 8B 44 24 40) // should be unique
alloc(newmem,$1000,aobPlayer_Focus)

label(code)
label(return)
label(pPlayerVel)
registersymbol(pPlayerVel)
newmem:
 push rbx
 push rcx
 xor rcx,rcx
 mov rbx,pPlayerVel
Start:
 cmp [rbx+rcx*8],0
 jne short @f
  mov [rbx+rcx*8],rax
  jmp End
 @@:
 cmp [rbx+rcx*8],rax
 je End
 inc rcx
 jmp Start
End:
 pop rcx
 pop rbx
 cmp qword ptr[pPlayerVel+10],0
 je code
 xorps xmm0,xmm0
 movups [pPlayerVel],xmm0
 movups [pPlayerVel+10],xmm0
code:
  movups xmm0,[rax]
  movsd xmm1,[rax+10]
  jmp return
align 10 00
pPlayerVel:
dq 0
// ...

aobPlayer_Focus:
  jmp newmem
  nop 3
return:
registersymbol(aobPlayer_Focus)

[DISABLE]

aobPlayer_Focus:
  db 0F 10 00 F2 0F 10 48 10

unregistersymbol(aobPlayer_Focus)
dealloc(newmem)

