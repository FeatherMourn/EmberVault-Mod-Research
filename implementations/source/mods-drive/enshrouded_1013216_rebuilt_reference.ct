local content = "Null"
if file == nil then
 showMessage("Error: No Saved Positions") error("no saved pos")
else
 io.input(file)
 content = io.read()
 io.close(file)
end

List = json.decode(content)

TPNames = createStringList()

for i,v in pairs(List) do
 TPNames.add(v.Name)
end

local index,name = showSelectionList("Select A Location Name", "Select:", TPNames, false)
if index == -1 then error("no selection") return end

for i,v in pairs(List) do
 if v.Name == name then
  Player_Teleport(v.X,v.Y,v.Z)
 end
end

 
