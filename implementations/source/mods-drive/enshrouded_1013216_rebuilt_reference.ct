              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
_ic = 0

local function AddItem(name,hash)
 for i,v in pairs(HashList) do
   if i == name then
   name = name .. "_" .. tostring(_ic)
   _ic = _ic + 1
   end
 end
 nameList.add(name)
 HashList[name] = hash
end

local Item = getAddress("[pItem]")

if Item == 0 then print("Error: no item ptr") error("nullptr") return end

nameList = createStringList()
