                  </CheatEntries>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
            <CheatEntry>
              <ID>1337321179</ID>
              <Description>"[Teleport]"</Description>
              <Options moHideChildren="1"/>
              <Color>FF8000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
function Player_Teleport( X, Y, Z, PlayerPos)
    local PlayerPos = PlayerPos or getAddressSafe("[pPos]")
    if not PlayerPos then print("Error: no player pos pointer") return false end

    for i=0,90 do
     writeQword(PlayerPos+0x4,X) writeQword(PlayerPos+0xC,Y) writeQword(PlayerPos+0x14,Z)
     sleep(1)
    end

    error("OK")
end
