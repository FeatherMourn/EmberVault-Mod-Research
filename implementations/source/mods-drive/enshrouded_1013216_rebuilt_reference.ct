          <AssemblerScript>{ Game   : enshrouded.exe
  Version: 
  Date   : 2024-01-27
  Author : cfe

  This script does blah blah blah
}

[ENABLE]
globalalloc(GravityKeyThread,$1000,$process)
createthread(GravityKeyThread)

label(bRun)
registersymbol(bRun)
label(iKey)
registersymbol(iKey)
label(bActive)
registersymbol(bActive)
GravityKeyThread:
sub rsp,28
L1:
  mov ecx,[iKey]
  call USER32.GetAsyncKeyState
  and eax,1
  je short @f
   xor byte ptr[bActive],1
  @@:
  cmp byte ptr[bActive],0
  je short Skip
  mov rbx,pPos
  mov rbx,[rbx]
  test rbx,rbx
  je Skip
   mov ecx,A0
   call USER32.GetAsyncKeyState
   and eax,1
   je short @f
    je short @f
     mov eax,[rbx+C]
     inc eax
     mov [rbx+C],eax
   @@:
   mov ecx,11
   call USER32.GetAsyncKeyState
   and eax,1
   je short @f
    je short @f
     mov eax,[rbx+C]
     dec eax
     mov [rbx+C],eax
   @@:
  Skip:
  cmp byte ptr[bRun],1
je L1
add rsp,28
ret
bRun:
db 1
iKey:
dd 52
bActive:
db 0

aobscanmodule(aobgravity_apply_velocity_actor,enshrouded.exe,F3 0F 58 42 04 F3 0F 58 5A) // should be unique
alloc(newmem,$1000,aobgravity_apply_velocity_actor)

label(code)
label(return)
newmem:

code:
 addss xmm0,[rdx+04]
 push rbx
 mov rbx,bActive
 cmp byte ptr[rbx],0
 pop rbx
 je return
 xorps xmm0,xmm0
  jmp return

aobgravity_apply_velocity_actor:
  jmp newmem
return:
registersymbol(aobgravity_apply_velocity_actor)

[DISABLE]
bRun:
db 0

aobgravity_apply_velocity_actor:
  db F3 0F 58 42 04

unregistersymbol(*)
dealloc(newmem)

