[ENABLE]

local TPName = inputQuery("Set A Name","","")
if TPName == nil then error("no input") return end

local PlayerPos = getAddress("[pPos]")
if PlayerPos == 0 then print("Error: no player pos pointer") error("nullptr") return end

X1 = readQword(PlayerPos+0x4)
Y1 = readQword(PlayerPos+0xC)
Y1 = Y1 + 2
Z1 = readQword(PlayerPos+0x14)

local TP = {}
TP["Name"] = TPName
TP["X"] = tostring(X1)
TP["Y"] = tostring(Y1)
TP["Z"] = tostring(Z1)

local List = {}
file = io.open("Enshrouded_Teleports.json", "r")
local content = "Null"
if file == nil then
 content = "{}"
else
 io.input(file)
 content = io.read()
 io.close(file)
end

List = json.decode(content)


for i,v in pairs(List) do
 if v.Name == TPName then showMessage("Error: A Entry With That Name Already Exists!") return end
end

table.insert(List,TP)

local val = json.encode(List)
file = io.open("Enshrouded_Teleports.json", "w")
file:write(val)
file:close()

 
