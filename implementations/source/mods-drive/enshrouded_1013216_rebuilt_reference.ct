          <ID>1337321118</ID>
          <Description>"XP Multiplier x?"</Description>
          <Options moHideChildren="1"/>
          <Color>FF8000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{ Game   : enshrouded.exe
  Version: 
  Date   : 2025-11-10
  Author : cfemen

  This script does blah blah blah
}

[ENABLE]

aobscanmodule(player_level,enshrouded.exe,45 01 3C 88 48 8B CB) // should be unique
alloc(newmem,$1000,player_level)

label(code)
label(return)
label(fXPMul)
registersymbol(fXPMul)
newmem:
 cvtsi2ss xmm0,r15d
 movss xmm1,[fXPMul]
 mulss xmm0,xmm1
 cvtss2si r15d,xmm0
code:
  add [r8+rcx*4],r15d
  mov rcx,rbx
  jmp return
fXPMul:
dd (float)2

player_level:
  jmp newmem
  nop 2
return:
registersymbol(player_level)

[DISABLE]

player_level:
  db 45 01 3C 88 48 8B CB

unregistersymbol(player_level)
dealloc(newmem)

