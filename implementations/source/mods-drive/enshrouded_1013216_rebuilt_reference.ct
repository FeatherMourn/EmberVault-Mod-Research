            <CheatEntry>
              <ID>1337321137</ID>
              <Description>"Delete Item"</Description>
              <Color>808000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
local function AddItem(name,hash)
 nameList.add(name)
 HashList[name] = hash
end

local Item = getAddress("[pItem]")

if Item == 0 then print("Error: no item ptr") error("nullptr") return end

local res = messageDialog("Really Delete Current Item?",0,0,1)

if res ~= 6 then error("cancel") return end

writeInteger(Item,0)
writeInteger(Item+4,0)
writeInteger(Item+8,0)

 
[DISABLE]

</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>1337321138</ID>
              <Description>"Print Hash"</Description>
              <Color>C0C0C0</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript Async="1">{$lua}
if syntaxcheck then return end
[ENABLE]

local Item = getAddress("[pItem]")
if Item == 0 then print("Error: no item ptr") error("nullptr") return end
local hash = readInteger(Item)
--printf("%08x",hash)
printf('AddItem("NAME",0x%08x)',hash)
--printf("%08x:NAME",hash)
error("OK")

[DISABLE]
</AssemblerScript>
