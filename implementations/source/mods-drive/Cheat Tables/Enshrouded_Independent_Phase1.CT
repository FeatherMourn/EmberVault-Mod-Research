  </CheatEntries>
  <UserdefinedSymbols>
    <SymbolEntry><Name>Independent_Phase1</Name><Address>0</Address></SymbolEntry>
  </UserdefinedSymbols>
  <LuaScript>-- Independent Enshrouded table, Phase 1.
-- Reference tables were used only for feature vocabulary.
-- Static status is authoritative; live gameplay validation remains user work.

Independent_AOB_Allocations = Independent_AOB_Allocations or {}

function Independent_AOB_Scan(moduleName, pattern)
  if type(moduleName) ~= 'string' or type(pattern) ~= 'string' then
    error('AOB scan requires a module name and pattern')
  end
  local hits = AOBScanModule(moduleName, pattern)
  local count = hits and hits.Count or 0
  if count ~= 1 then
    if hits then hits.destroy() end
    error(string.format('AOB rejected: expected exactly 1 match, found %d', count))
  end
  local address = tonumber(hits[0], 16)
  hits.destroy()
  return address
end

function Independent_RegisterAllocation(addressName)
  if type(addressName) == 'string' then
    Independent_AOB_Allocations[addressName] = true
  end
end

function Independent_Cleanup()
  for name in pairs(Independent_AOB_Allocations) do
    if getAddressSafe(name) then unregisterSymbol(name) end
    Independent_AOB_Allocations[name] = nil
  end
end</LuaScript>
</CheatTable>
